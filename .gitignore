# FlexFringe binary (compiled from source, not committed)
# FlexFringe/flexfringe
# FlexFringe/flexfringe.exe

# Decompressed alert files (keep only .gz originals)
alerts/**/*.json
!alerts/**/*.json.gz

# SAGE experiment outputs (generated trace files and attack graph directories)
*.txt
!requirements.txt
*AGs/
*.png
*.svg
*.dot

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Tool scratch output (browser automation logs and page snapshots)
.playwright-mcp/

# MITRE mapping experiment: cached raw STIX bundle (large, re-downloadable)
experiments/mitre_mapping/archive/enterprise-attack.json
experiments/mitre_mapping/attack_mapper/data/enterprise-attack.json

# MITRE mapping experiment (tiered approach): cached ET Open ruleset (large, re-downloadable)
experiments/mitre_mapping/archive/tiered_approach/emerging-all.rules
experiments/mitre_mapping/attack_mapper/data/emerging-all.rules

# MITRE mapping experiment (sigma_corpus): cloned SigmaHQ ruleset (large, re-clonable)
experiments/mitre_mapping/attack_mapper/sigma_corpus/sigmahq/

# MITRE mapping experiment (elastic_corpus): cloned Elastic detection-rules (large, re-clonable)
experiments/mitre_mapping/attack_mapper/elastic_corpus/detection-rules/

# MITRE mapping experiment (splunk_corpus): cloned Splunk security_content (large, re-clonable)
experiments/mitre_mapping/attack_mapper/splunk_corpus/security_content/

# MITRE mapping experiment: kNN corpus embedding cache (44MB, regenerated on
# first run; knn_resolver.py rebuilds it whenever the corpus or model changes)
experiments/mitre_mapping/attack_mapper/data/knn_corpus_embeddings.npz

# MITRE mapping experiment (entity_dicts): cached upstream dictionaries (large, re-fetchable)
experiments/mitre_mapping/attack_mapper/entity_dicts/sources/

# MITRE mapping experiment (entity_ner): precomputed GLiNER spans over the
# corpus (~28 min to rebuild via entity_ner/build_spans.py, deterministic given
# the pinned model/threshold/labels in entity_tagger.py). Regenerable model
# output, so it stays out of history like the embedding cache above.
experiments/mitre_mapping/attack_mapper/data/entity_spans.json.gz

# Same, for the SecureModernBERT-NER backend (~30 min to rebuild via
# `build_spans.py --backend securemodernbert`).
experiments/mitre_mapping/attack_mapper/data/entity_spans_smb.json.gz

# Measured corpus document frequency for the replace-mode DF gate
# (entity_ner/df_table.py). Derived deterministically from the labelled
# corpora, so it regenerates in seconds and stays out of history.
experiments/mitre_mapping/attack_mapper/data/entity_df.json.gz
